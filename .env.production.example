# =============================================================================
# Denvia 환경변수 — 운영 서버용 (.env.production) 템플릿
# =============================================================================
# 이 파일은 git 에 커밋됩니다. 실제 비밀값은 절대 여기 넣지 말 것.
#
# 사용법 (서버에서):
#   cp .env.production.example .env.production
#   nano .env.production       ← 클라이언트 발급 키로 채움
#   docker compose -f infra/docker-compose.prod.yml up -d
#
# .env.production 은 .gitignore 처리됨.
# =============================================================================
# ENV: production
# =============================================================================
ENVIRONMENT=production

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres 컨테이너 비밀번호 — 강력한 랜덤 문자열로 교체 필수.
# 생성 예: openssl rand -hex 24
POSTGRES_PASSWORD=__REPLACE_WITH_STRONG_RANDOM__
DATABASE_URL=postgresql+psycopg://denvia:__REPLACE_WITH_STRONG_RANDOM__@postgres:5432/denvia
DATABASE_SYNC_URL=postgresql+psycopg://denvia:__REPLACE_WITH_STRONG_RANDOM__@postgres:5432/denvia

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# 무조건 새로 생성. 절대 dev 값 재사용 금지.
# 생성: openssl rand -hex 32
DENVIA_JWT_SECRET=__REPLACE_WITH_OPENSSL_RAND_HEX_32__
DENVIA_JWT_ALGORITHM=HS256

# ── Admin 초기 계정 ───────────────────────────────────────────────────────────
# 클라이언트 운영 이메일/휴대폰. 첫 로그인 후 비밀번호 즉시 변경 권장.
DENVIA_ADMIN_EMAIL=admin@denvia.ai.kr
DENVIA_ADMIN_INITIAL_PASSWORD=__REPLACE_WITH_STRONG_PASSWORD__
# 관리자 알림톡 수신처는 DB users.phone 만 본다 (btmdesign@naver.com 우선,
# admin@denvia.ai.kr 차순위). 환경변수 폴백은 사용하지 않는다.

# ── Observability (Sentry) ────────────────────────────────────────────────────
# 운영용 Sentry 프로젝트 DSN.
SENTRY_DSN_WEB=
SENTRY_DSN_API=
SENTRY_ENVIRONMENT=production

# ── OpenAI ────────────────────────────────────────────────────────────────────
# 클라이언트 발급 OpenAI API 키 (운영용).
OPENAI_API_KEY=

# ── OAuth 3종 — 클라이언트 발급 키 ─────────────────────────────────────────────
# 각 콘솔(Kakao/Google/Naver)에 운영 redirect URI 사전 등록 필수.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://denvia.ai.kr/api/v1/auth/oauth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://denvia.ai.kr/api/v1/auth/oauth/google/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=https://denvia.ai.kr/api/v1/auth/oauth/naver/callback
OAUTH_WEB_ORIGIN=https://denvia.ai.kr

# ── 결제 PG ──────────────────────────────────────────────────────────────────
# Fernet.generate_key() 로 새로 생성. dev 값 절대 재사용 금지.
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BILLING_KEY_ENC_KEY=__REPLACE_WITH_FERNET_KEY__
PG_PROVIDER=toss
PRO_MONTHLY_PRICE_KRW=9900

# ── 토스페이먼츠 ──────────────────────────────────────────────────────────────
# 심사 제출 단계: 샌드박스 테스트 키 그대로 사용 (실제 결제 발생 안 함).
# 심사 통과 후: live_sk_* / live_ck_* 로 교체.
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq

# ── 메시징 / 알리고 알림톡 ───────────────────────────────────────────────────
# 운영은 aligo 로 발송. 키 누락 시 어댑터가 AligoConfigError 던짐.
MESSAGING_PROVIDER=aligo

# ── 알리고 계정 (클라이언트 알리고 계정에서 발급) ──────────────────────────────
ALIGO_USER_ID=
ALIGO_API_KEY=

# ── 발신번호 / 카카오 채널 (운영용) ────────────────────────────────────────────
# 알리고에 사전 인증된 운영 발신번호 — 하이픈 없이 숫자만
ALIGO_SENDER=
# 카카오 비즈 심사 통과한 운영 채널의 송신프로필 키
ALIGO_SENDER_KEY=

# ── 발송 모드 ────────────────────────────────────────────────────────────────
# 운영은 반드시 false — true 로 두면 사용자에게 알림톡이 안 감.
ALIGO_TEST_MODE=false

# ── 템플릿 코드 매핑 ─────────────────────────────────────────────────────────
# 알리고 콘솔 등록 17개 (카카오 심사 통과 16개 + notice.generic 재심사 대기).
# 카탈로그: docs/ALIMTALK_TEMPLATES.md (등록명·tpl_code SSOT)
# 매핑 누락된 키 호출 시 어댑터가 AligoConfigError로 거부 → 다른 발송에는 영향 없음.
ALIMTALK_TEMPLATE_MAP_JSON={}

# ── 프론트 공개 환경변수 (빌드 시점에 번들에 박힘) ─────────────────────────────
# Next.js 가 호출할 API 베이스. 운영은 도메인 그대로 (nginx 가 /api/* 프록시).
NEXT_PUBLIC_API_URL=https://denvia.ai.kr
# 운영 카카오 채널 URL (심사 통과 후 발급).
NEXT_PUBLIC_KAKAO_CHANNEL_URL=
# 프론트 Sentry DSN (운영용 별도 프로젝트 권장).
NEXT_PUBLIC_SENTRY_DSN=
