# 의존성
node_modules/
.pnpm-debug.log*
.next/
out/
dist/
build/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
*.egg-info/
dist/
.eggs/

# 환경변수 (절대 커밋 금지)
.env
.env.local
.env.*.local
.env.production
.env.backup.*

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/
.idea/
*.iml

# 로그
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Next.js app 라우트 안의 logs/ 폴더는 코드라서 예외
# (관리자 페이지의 "로그" 라우트 등 — 새 logs 라우트 추가돼도 자동 커버)
!web/src/app/**/logs/
!web/src/app/**/logs/**

# 테스트
coverage/
.nyc_output/
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Docker 볼륨 데이터
postgres_data/
redis_data/

# Playwright
playwright-report/
test-results/

# FAISS 인덱스 데이터 (gitignore, .gitkeep으로 디렉터리만 추적)
api/data/faiss/
!api/data/faiss/.gitkeep

# 루트 레벨 런타임 데이터 (api/data/faiss와 별개로 생성된 로컬 캐시)
/data/

# 사용자 로컬 launcher 스크립트
launch-claude.bat

# 관리자 지식 파일 업로드 (런타임 생성 — 디렉터리만 추적)
api/data/uploads/
!api/data/uploads/.gitkeep

# 참고 자료 (개발 파일 아님)
자료/
기획자료/
RAG 코드/
에러화면/
_bmad-output/
_bmad-output*.zip

# AI 개발 도구/흔적 (Claude, BMAD, Codex)
# - 루트 CLAUDE.md 는 로컬 프로젝트 운영 노트로 디스크에는 유지하되 추적은 제외
# - 벤더 디렉토리(vendor/)는 제3자 라이브러리 원본이라 예외로 둠
.claude/
_bmad/
.agents/
**/CLAUDE.md
**/AGENTS.md
!vendor/**
# 단, 벤더 예외(!vendor/**)로 노출되는 파이썬 캐시·에디터 설정은 다시 제외
vendor/**/__pycache__/
vendor/**/.vscode/
.codex

# 세션 임시 작업 산출물 (CLAUDE.md: outputs/ 는 세션 종료 시 사라지는 임시 파일)
outputs/

# 프로젝트 문서 (운영/아키텍처/ADR/런북 등 — 추적 제외)
docs/
/README.md
/api/README.md
/web/README.md
.github/PULL_REQUEST_TEMPLATE.md

# Celery 런타임 산출물
celerybeat-schedule
celerybeat-schedule.*

# Celery 런타임 산출물
celerybeat-schedule
celerybeat-schedule.*
