# 의존성
node_modules/
.pnpm-debug.log*
.next/
out/
dist/
build/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
*.egg-info/
dist/
.eggs/

# 환경변수 (절대 커밋 금지)
.env
.env.local
.env.*.local
.env.production
.env.backup.*

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/
.idea/
*.iml

# 로그
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Next.js app 라우트 안의 logs/ 폴더는 코드라서 예외
# (관리자 페이지의 "로그" 라우트 등 — 새 logs 라우트 추가돼도 자동 커버)
!web/src/app/**/logs/
!web/src/app/**/logs/**

# 테스트
coverage/
.nyc_output/
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Docker 볼륨 데이터
postgres_data/
redis_data/

# Playwright
playwright-report/
test-results/

# FAISS 인덱스 데이터 (gitignore, .gitkeep으로 디렉터리만 추적)
api/data/faiss/
!api/data/faiss/.gitkeep

# 루트 레벨 런타임 데이터 (api/data/faiss와 별개로 생성된 로컬 캐시)
/data/

# 관리자 지식 파일 업로드 (런타임 생성 — 디렉터리만 추적)
api/data/uploads/
!api/data/uploads/.gitkeep

# 참고 자료 (개발 파일 아님)
자료/
기획자료/
RAG 코드/
에러화면/
_bmad-output/
_bmad-output*.zip

# 로컬 개발 환경 설정·노트 (저장소에 커밋하지 않음, 벤더 디렉터리는 예외)
_bmad/
!vendor/**

# 프로젝트 문서 (운영/아키텍처/ADR/런북 등 — 추적 제외)
docs/
/README.md
/api/README.md
/web/README.md
.github/PULL_REQUEST_TEMPLATE.md

# Celery 런타임 산출물
celerybeat-schedule
celerybeat-schedule.*

# Celery 런타임 산출물
celerybeat-schedule
celerybeat-schedule.*
