# 모노레포(pnpm workspace) 구조로 빌드한다.
# build context = 프로젝트 루트 (docker-compose의 web.build.context: ..)
# web/package.json이 vendor/montage-web/packages/* 의 wds 패키지들을 workspace:^ 로 참조하므로
# 루트 매니페스트 + 워크스페이스 자식들의 매니페스트를 함께 가져와 한 번에 install 한다.

# ── 1) deps: 의존성만 설치 (캐시 효율을 위해 소스와 분리)
FROM node:22-alpine AS deps
WORKDIR /repo

# 루트 lockfile + workspace 설정 (이 모노레포는 루트 package.json 없이 pnpm-workspace.yaml로 정의)
COPY pnpm-lock.yaml pnpm-workspace.yaml ./

# 자식 워크스페이스의 매니페스트만 먼저 복사 (소스 변경에 install이 다시 안 돌게)
COPY web/package.json web/
COPY vendor/montage-web/packages ./vendor/montage-web/packages

RUN corepack enable && pnpm install --frozen-lockfile --filter web...

# ── 2) builder: 소스 복사 후 Next.js 빌드
FROM node:22-alpine AS builder
WORKDIR /repo
ENV CI=true

# deps 단계의 결과를 그대로 가져옴 (node_modules 포함)
COPY --from=deps /repo /repo

# vendored WDS 패키지는 Git에 dist 산출물을 포함하지 않으므로 이미지 빌드 중 먼저 빌드한다.
# web의 workspace 의존성(@wanteddev/wds*)이 이 dist를 참조한다.
COPY vendor/montage-web/ vendor/montage-web/
RUN corepack enable && \
    cd /repo/vendor/montage-web && \
    pnpm install --frozen-lockfile && \
    pnpm --filter ./packages/wds-theme run build && \
    pnpm --filter ./packages/wds-engine run build && \
    pnpm --filter ./packages/wds-icon run build && \
    pnpm --filter ./packages/wds run build && \
    pnpm --filter ./packages/wds-nextjs run build

# 실제 web 소스
COPY web/ web/

# NEXT_PUBLIC_* 는 Next.js 빌드 시점에 번들에 박히므로 ARG → ENV 로 주입.
# docker-compose 의 build.args 에서 .env.production 값이 흘러옴.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_TOSS_CLIENT_KEY
ARG NEXT_PUBLIC_KAKAO_CHANNEL_URL
ARG NEXT_PUBLIC_SENTRY_DSN
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_TOSS_CLIENT_KEY=$NEXT_PUBLIC_TOSS_CLIENT_KEY \
    NEXT_PUBLIC_KAKAO_CHANNEL_URL=$NEXT_PUBLIC_KAKAO_CHANNEL_URL \
    NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /repo/web
RUN corepack enable && pnpm build

# ── 3) runner: 빌드 결과 + node_modules 그대로 두고 next start
# 모노레포 + Next 16 조합에서 standalone output이 산출되지 않아 일반 start 방식 사용.
# 이미지 사이즈는 다소 크지만 동작 보장.
FROM node:22-alpine AS runner
WORKDIR /repo
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
COPY --from=builder /repo /repo
WORKDIR /repo/web
EXPOSE 3000
# Do not invoke pnpm in the runtime container. pnpm 11 performs a dependency
# status check before scripts and can re-resolve workspace packages, which makes
# production boot depend on the workspace graph instead of the built image.
CMD ["node", "node_modules/next/dist/bin/next", "start"]
