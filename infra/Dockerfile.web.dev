FROM node:22-alpine

WORKDIR /workspace

ENV NEXT_TELEMETRY_DISABLED=1
ENV PNPM_HOME=/pnpm
ENV PATH=/pnpm:$PATH

RUN corepack enable

EXPOSE 3000

CMD ["sh", "-c", "pnpm config set store-dir /pnpm/store && pnpm install --frozen-lockfile && pnpm --dir /workspace/web exec next dev --webpack --hostname 0.0.0.0 --port 3000"]
