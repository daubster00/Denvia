FROM python:3.12-slim

WORKDIR /app

# uv 설치
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 의존성 복사 및 설치
COPY api/pyproject.toml api/uv.lock ./
RUN uv sync --frozen --no-dev

# 소스 복사
COPY api/ .

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "api.src.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
