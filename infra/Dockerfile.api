FROM python:3.12-slim

# /workspace를 루트로 삼고 api/ 디렉터리 구조를 그대로 유지
# (코드가 `from api.src.X import Y` 형식으로 import하기 때문)
WORKDIR /workspace/api

# uv 설치
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 의존성 복사 및 설치 — README.md는 추적 제외(.gitignore)되어 빌드 컨텍스트에 없으므로
# pyproject 의 readme 메타데이터를 제거하고 본 COPY에서도 빠짐.
COPY api/pyproject.toml api/uv.lock ./
RUN uv sync --frozen --no-dev

# 소스 복사
COPY api/ ./
COPY vendor/ /workspace/vendor/

# PYTHONPATH — vendor/ 아래 rag 패키지를 직접 임포트 가능하도록
ENV PYTHONPATH=/workspace/vendor:$PYTHONPATH

# uvicorn은 /workspace에서 실행 — `api.src.main`이 네임스페이스 패키지로 해석됨
WORKDIR /workspace

EXPOSE 8000

CMD ["uv", "--project", "/workspace/api", "run", "uvicorn", "api.src.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
