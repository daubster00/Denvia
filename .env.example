# =============================================================================
# Denvia 환경변수 — 로컬 개발용 (.env) 템플릿
# =============================================================================
# 이 파일은 git에 커밋됩니다. 실제 비밀값은 절대 여기 넣지 말 것.
#
# 사용법:
#   cp .env.example .env   ← 로컬 개발 (개발자 개인 키)
#   .env 는 gitignore 처리됨.
#
# 운영 서버(AWS Lightsail) 배포는 별도 파일 사용:
#   cp .env.production.example .env.production
#   → 클라이언트 발급 키로 채운 뒤 서버에 업로드.
#   → docker-compose.prod.yml 이 .env.production 을 참조함.
# =============================================================================
# ENV: development
# =============================================================================
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://denvia:password@postgres:5432/denvia
# 동기 URL (Alembic env.py용)
DATABASE_SYNC_URL=postgresql+psycopg://denvia:password@postgres:5432/denvia
# Postgres 컨테이너 비밀번호 (개발용 약식)
POSTGRES_PASSWORD=password

# ── Redis (DB 0~4 고정 용도) ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# 개발용 약식. 운영은 `openssl rand -hex 32` 결과로 교체.
DENVIA_JWT_SECRET=change_me_in_production_minimum_32_chars
DENVIA_JWT_ALGORITHM=HS256

# ── Admin 초기 계정 ───────────────────────────────────────────────────────────
DENVIA_ADMIN_EMAIL=admin@denvia.local
DENVIA_ADMIN_INITIAL_PASSWORD=change_me_in_production
# 예산 경고 알림톡 수신 휴대폰 (운영 시 클라이언트 휴대폰)
DENVIA_ADMIN_PHONE=

# ── Observability (Sentry) ────────────────────────────────────────────────────
# 로컬 개발은 보통 비워둠. 필요하면 개발자 개인 Sentry 프로젝트 DSN.
SENTRY_DSN_WEB=
SENTRY_DSN_API=
SENTRY_ENVIRONMENT=development

# ── OpenAI (RAG용) ────────────────────────────────────────────────────────────
# 개발용: 개발자 개인 키. 운영용: 클라이언트 발급 키.
OPENAI_API_KEY=

# ── OAuth 3종 (Story 1.6) — 개발자 개인 키 ────────────────────────────────────
# 운영 서버용 키는 .env.production 에 별도 입력.
# 개발자 콘솔에서 redirect URI 로 아래 localhost 주소 등록 필요.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/naver/callback
OAUTH_WEB_ORIGIN=http://localhost:3000

# ── 결제 PG (Story 3.1) ───────────────────────────────────────────────────────
# Fernet.generate_key() 로 생성한 base64 urlsafe 32B 키
BILLING_KEY_ENC_KEY=
PG_PROVIDER=toss
PRO_MONTHLY_PRICE_KRW=9900

# ── 토스페이먼츠 (Story 3.2) — 샌드박스 테스트 키 ──────────────────────────────
# 공식 샌드박스 키. 심사 통과 후 라이브 키로 교체.
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq

# ── 메시징 (Story 4.1) ────────────────────────────────────────────────────────
# 카카오 비즈 알림톡 심사 통과 전까지 stub 유지. structlog 출력만 함.
# 통과 후: aligo | nhn_cloud
MESSAGING_PROVIDER=stub
ALIMTALK_TEMPLATE_MAP_JSON={}

# ── 프론트 공개 환경변수 (Story 2.7) ──────────────────────────────────────────
# Next.js 가 호출할 API 베이스. 로컬은 host-run 시 localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
# FR32 우측 하단 고객문의 FAB 클릭 시 새 탭으로 열리는 카카오톡 채널 URL.
# 미설정 시 위젯 자체 비렌더.
NEXT_PUBLIC_KAKAO_CHANNEL_URL=
# 프론트 Sentry DSN (로컬은 보통 비워둠).
NEXT_PUBLIC_SENTRY_DSN=
